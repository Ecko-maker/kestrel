# Copy this file to .env and fill in your keys. Never commit .env.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override a provider's default model
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_MODEL=qwen3:4b

# Phase 4 router (off unless KESTREL_PROVIDERS=routed; see src/kestrel/router.py and docs/phase4-plan.md)
# KESTREL_ROUTER_STUDENT=ollama
# KESTREL_ROUTER_STUDENT_MODEL=
# KESTREL_ROUTER_TEACHER=groq
# KESTREL_ROUTER_TEACHER_MODEL=
# KESTREL_ROUTER_LINEAGE=
# KESTREL_ROUTER_STUDENT_CTX=16384
# KESTREL_ROUTER_CTX_MARGIN=0.8
# KESTREL_ROUTER_MAX_STUDENT_HEALTH=0.10
