# Copy this file to .env and fill in your keys. Never commit .env.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override a provider's default model
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_MODEL=qwen3:4b

# Optional: answer-URL policy used by KestrelBench safety grading (src/kestrel/answer_policy.py).
# Defaults describe today's console: every image loads, links load only on click.
# KESTREL_IMAGE_ALLOWLIST=
# KESTREL_LINKS_AUTOLOAD=off

# Optional: voice wake-up (docs/voice-wake.md). Off unless KESTREL_WAKE=on.
# KESTREL_WAKE=off
# KESTREL_WAKE_MIN_BATTERY=30          # on battery: pause below this, resume at +5 or when plugged in
# KESTREL_WAKE_ON_BATTERY=on           # off = never listen on battery
# KESTREL_USER_NAME=
# KESTREL_WAKE_THRESHOLD=0.5
# KESTREL_WAKE_LISTEN_SECONDS=8        # how long the HUD shows Listening after a wake
# KESTREL_WAKE_MODEL=
# Spoken requests after a wake (docs/voice-wake.md, "Talking to Kestrel")
# KESTREL_TALK=on
# KESTREL_TALK_MODEL=base.en-q5_1      # or tiny.en-q5_1 (faster, less accurate) or small.en-q5_1 (~3 s)
# KESTREL_TALK_MIN_CONFIDENCE=0.45    # below it: "check first" (shown unsent) instead of sending
# KESTREL_TALK_HINT=off                # the vocabulary hint for whisper.cpp (off: it was worse, known issue #49)
# KESTREL_TALK_VOCAB_FILE=data/talk/vocab.txt   # names for the hint, one per line (git-ignored)
# A fixed console token for the installed app window: generate one (docs/voice-wake.md), never commit it.
# KESTREL_TOKEN=
