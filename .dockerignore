# Secrets and local state never go into the image.
.env
.env.*
logs/
data/
*.db

# Your own workspace files stay private; only the two samples are copied.
workspace/*
!workspace/notes.txt
!workspace/suspicious_email.txt

# Built or downloaded again inside the build.
.venv/
**/node_modules/
console/dist/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Not needed at runtime.
.git/
.github/
.vscode/
docs/
tests/
scripts/
