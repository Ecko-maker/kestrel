# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets / local environment
.env
.env.*
!.env.example

# Kestrel workspace: only the sample file is tracked
workspace/*
!workspace/notes.txt
!workspace/suspicious_email.txt

# Approval audit log (local record of your decisions)
logs/

# Exported training data (from your conversations), and any folder named data (the safety split's git check relies on it)
data/
# ...except the kestrel-data package's code
!src/kestrel/data/

# Local datasets for the opt-in data tools (KESTREL_DATA_DIR default; docs/data.md)
/datasets/

# Test and tool output
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# KestrelBench run results (the committed baseline lives in evals/kestrelbench/)
evals/results/

# Google OAuth client files and tokens (docs/google.md): never in git
client_secret*.json
.credentials/
